# ============================================================================
# Fork identity configuration
# ============================================================================
# scripts/fork_identity.py reads this file and rewrites a *pristine upstream
# worktree* into this fork's identity.  Nothing in upstream's own files is ever
# committed with these values, which is what keeps upstream sync conflict-free.
#
# After changing anything here, run:
#   scripts/fork_identity.py apply --check-anchors
# and then the release pipeline (or a local build) to publish new artifacts.
# ============================================================================

# --- fork repository --------------------------------------------------------
FORK_OWNER=keweiya
FORK_REPO=HMA-OSS

# --- upstream ---------------------------------------------------------------
UPSTREAM_SLUG=frknkrc44/HMA-OSS
UPSTREAM_BRANCH=master

# --- release identity -------------------------------------------------------
# Android applicationId / namespace.  Must be a valid java package, must NOT
# contain any upstream marker (frknkrc44 / hma / hidemyapplist).
APP_ID=io.moonlit.quarry

# Namespace for the historical `icu.nullptr.hidemyapplist` sources.
# Must be a child of APP_ID.
LEGACY_NS=io.moonlit.quarry.legacy

# Gradle root project name -> APK / Magisk zip file names.
PROJECT_NAME=HMA-OSS

# Launcher label written to res/values*/strings.xml (app_name).
APP_NAME=Quarry

# Loader module identity.  The id becomes /data/adb/modules/<id> and the value
# of `id=` in module.prop, so it must not contain framework words.
# The *displayed* name / description intentionally keep upstream's spelling so
# the module looks like the original one in the manager; only the manager app's
# package name (and other in-app identifiers) differ.
MODULE_ID=quarry
MODULE_NAME=HMA-OSS Zygisk
MODULE_AUTHOR=keweiya
MODULE_DESC=A Zygisk backend for HMA-OSS

# /data/misc/<STATE_PREFIX>_<random>/status.json  (system service state dir).
# Also used as the boot script name.
STATE_PREFIX=quarry_state
